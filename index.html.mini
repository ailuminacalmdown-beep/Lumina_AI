cp index.html index.html.full
cat > index.html << 'EOF'
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Lumina Simple</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #0a0a1a;
    font-family: sans-serif;
    color: white;
  }
  .header {
    background: #1a1a3e;
    padding: 15px;
    text-align: center;
    flex-shrink: 0;
  }
  .chat {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .input-wrap {
    display: flex;
    padding: 10px;
    background: #1a1a3e;
    gap: 10px;
    flex-shrink: 0;
  }
  .input-wrap input {
    flex: 1;
    padding: 10px;
    border-radius: 20px;
    border: none;
  }
  .input-wrap button {
    padding: 10px 20px;
    border-radius: 20px;
    border: none;
    background: #6c63ff;
    color: white;
  }
  .message {
    max-width: 80%;
    padding: 8px 12px;
    border-radius: 18px;
    word-wrap: break-word;
  }
  .user { background: #4f46e5; align-self: flex-end; }
  .assistant { background: #1e293b; align-self: flex-start; }
</style>
</head>
<body>
<div class="header">🧃🌎 Lumina (simple)</div>
<div class="chat" id="chat"></div>
<div class="input-wrap">
  <input type="text" id="input" placeholder="Message...">
  <button id="send">Envoyer</button>
</div>
<script>
  const API_URL = `http://${window.location.hostname}:5004/chat`;
  const chatDiv = document.getElementById('chat');
  const input = document.getElementById('input');
  const sendBtn = document.getElementById('send');

  function addMessage(role, text) {
    const div = document.createElement('div');
    div.className = `message ${role}`;
    div.textContent = text;
    chatDiv.appendChild(div);
    chatDiv.scrollTop = chatDiv.scrollHeight;
  }

  async function sendMessage() {
    const msg = input.value.trim();
    if (!msg) return;
    input.value = '';
    addMessage('user', msg);
    try {
      const res = await fetch(API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg })
      });
      const data = await res.json();
      addMessage('assistant', data.reply || 'Pas de réponse');
    } catch(e) {
      addMessage('assistant', 'Erreur : ' + e.message);
    }
  }

  sendBtn.onclick = sendMessage;
  input.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });
</script>
</body>
</html>
EOF
