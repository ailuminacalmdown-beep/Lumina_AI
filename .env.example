# Copier en .env pour le développement local (jamais committer le vrai .env).
# Toutes les valeurs ci-dessous sont FACTICES.

# Clés Groq, séparées par des virgules (rotation automatique si l'une est à quota)
GROQ_API_KEYS=gsk_exemple_cle_1,gsk_exemple_cle_2

# PostgreSQL (Neon). Laisser vide en local : le serveur utilise alors SQLite (lumina.db).
# Utiliser la chaîne « pooled » de Neon, avec sslmode=require.
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-exemple-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Origines autorisées (CORS). "*" en dev. En production, restreindre ET inclure l'APK Capacitor :
CORS_ORIGINS=https://lumina-ai-sjyp.onrender.com,https://localhost,capacitor://localhost

# Derrière Render : 1 proxy. En local sans proxy : 0.
TRUST_PROXY_HOPS=1

# Jeton pour /status détaillé et /groq_models (en-tête X-Admin-Token). Laisser vide = désactivé.
ADMIN_TOKEN=remplacer-par-une-longue-valeur-aleatoire

# Réglages facultatifs (valeurs par défaut indiquées)
SESSION_TTL_DAYS=30
GROQ_TOTAL_TIMEOUT=45
MAX_MESSAGE_CHARS=8000
LIVE_MAX_PER_MIN=40
SIGNUP_MAX_PER_HOUR=10
GROQ_VISION_MODELS=
GROQ_STT_MODEL=whisper-large-v3-turbo
SQLITE_PATH=
PORT=5005

# --- Plans (v8) : 0 = illimité. Voir docs/BILLING.md ---
LIMITS_ENABLED=1
# FREE_DAILY_UNITS=25
# FREE_WEEKLY_UNITS=125
# FREE_DAILY_IMAGES=3
# PRO_DAILY_UNITS=150
# PRO_WEEKLY_UNITS=750
# PRO_DAILY_IMAGES=25
# MAX_DAILY_UNITS=450
# MAX_WEEKLY_UNITS=2250
# MAX_DAILY_IMAGES=75

# --- Recherche web (v8) : optionnelle. Sans clé, Lumina utilise DuckDuckGo et Wikipédia (résultats plus pauvres). ---
# TAVILY_API_KEY=
# FREE_DAILY_WEB=3
# PRO_DAILY_WEB=15
# MAX_DAILY_WEB=40

# --- Emails : vérification et mot de passe oublié (v9). Voir docs/EMAIL.md. Vide = fonctions désactivées. ---
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=
# EMAIL_FROM=no-reply@ton-domaine
# EMAIL_FROM_NAME=Lumina

# --- Agent (outils choisis par le modèle) et archive d'actualités. Voir docs/ENGINE.md ---
# AGENT_ENABLED=1                         # 0 = mode simple (recherche par mots-clés) uniquement
# AGENT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# NEWS_FEEDS=                             # vide = flux par défaut ; « off » = archive désactivée ; sinon URLs séparées par des virgules
# NEWS_REFRESH_MIN=30
